<!DOCTYPE html>
<%# Vista del listado. Datos que recibe de server.mjs: equipos, total, pagina,
    totalPaginas, filtros, categorias y los enlaces anterior/siguiente.
    Seguridad (XSS): todo dato se imprime con la etiqueta que escapa el HTML
    (igual-escapada) y nunca con la que no escapa (guion). Jamás se usa esa
    segunda con datos del usuario o de la base. %>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>Equipos</title>
</head>
<body>
  <h1>Equipos</h1>

  <%# Formulario GET: los filtros viajan en la URL y se conservan al paginar.
      Cada campo se rellena con el valor ya normalizado para que no se pierda. %>
  <form method="get" action="/equipos">
    <label>Buscar
      <input type="text" name="q" value="<%= filtros.q %>" maxlength="100">
    </label>
    <label>Categoría
      <select name="categoria">
        <option value="">Todas</option>
        <% categorias.forEach((c) => { %>
          <option value="<%= c %>" <%= c === filtros.categoria ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </label>
    <label>Estado
      <select name="disponible">
        <option value="" <%= filtros.disponible === '' ? 'selected' : '' %>>Todos</option>
        <option value="true" <%= filtros.disponible === 'true' ? 'selected' : '' %>>Disponible</option>
        <option value="false" <%= filtros.disponible === 'false' ? 'selected' : '' %>>Prestado</option>
      </select>
    </label>
    <label>Ordenar por
      <select name="orden">
        <option value="codigo" <%= filtros.orden === 'codigo' ? 'selected' : '' %>>Código</option>
        <option value="nombre" <%= filtros.orden === 'nombre' ? 'selected' : '' %>>Nombre</option>
      </select>
    </label>
    <button type="submit">Filtrar</button>
  </form>

  <%# Sin resultados se muestra un mensaje; si no, la tabla con enlaces a la ficha %>
  <% if (equipos.length === 0) { %>
    <p>No hay equipos que coincidan con los filtros.</p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>Código</th><th>Nombre</th><th>Categoría</th><th>Estado</th></tr>
      </thead>
      <tbody>
        <% equipos.forEach((e) => { %>
          <tr>
            <td><a href="/equipos/<%= e.id %>"><%= e.codigo %></a></td>
            <td><%= e.nombre %></td>
            <td><%= e.categoria %></td>
            <td><%= e.disponible ? 'Disponible' : 'Prestado' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <%# anterior/siguiente son null en los extremos; los enlaces ya incluyen los filtros %>
    <p>
      <% if (anterior) { %><a href="<%= anterior %>">Anterior</a><% } %>
      Página <%= pagina %> de <%= totalPaginas %> (<%= total %> equipos)
      <% if (siguiente) { %><a href="<%= siguiente %>">Siguiente</a><% } %>
    </p>
  <% } %>
</body>
</html>
